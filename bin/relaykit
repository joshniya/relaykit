#!/usr/bin/env sh
# relaykit wrapper used by the Claude Code plugin (plugin bin/ is on the Bash tool's PATH).
# Prefers an installed relaykit (pipx/uv/pip); falls back to the copy bundled with the plugin.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
for PY in python3 python; do
  if command -v "$PY" >/dev/null 2>&1 && "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
    if "$PY" -c 'import relaykit' 2>/dev/null; then exec "$PY" -m relaykit "$@"; fi
    exec "$PY" "$DIR/src/relaykit/__main__.py" "$@"
  fi
done
echo "relaykit needs Python 3.9+ on PATH (python3 or python)." >&2
exit 127
